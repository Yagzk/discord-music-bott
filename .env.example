# Bot token — https://discord.com/developers/applications
BOT_TOKEN=

# Discord application/client ID (slash command deployment için)
CLIENT_ID=

# Belirli bir sunucu ID'si (slash komutları anında test etmek için, boş bırakılırsa global)
GUILD_ID=

# Prefix komutlar için ön ek
PREFIX=.

# Debug loglama (true/false)
DEBUG=false

# Log kanalı ID — bot kullanım logları bu kanala gönderilir (boş bırakılırsa sadece konsola yazar)
LOG_CHANNEL_ID=

# Spotify API bilgileri — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
